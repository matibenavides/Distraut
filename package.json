{
  "name": "distraut",
  "displayName": "Distraut",
  "version": "0.0.1",
  "description": " Oculta videos con palabras clave, agregando sesiones de estudios",
  "author": "Matias Benavides",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsc -p tsconfig.test.json && node --test build/tests/tests/*.test.js"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "linkedom": "0.18.15",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage"
    ]
  }
}
